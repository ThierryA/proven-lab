{
  "name": "provenlab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Proven Lab: docs and tools that let AI agents build on WordPress core APIs, WP-CLI and the Cloud AI API.",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "ingest": "node scripts/ingest/run.mjs",
    "ingest:wp": "node scripts/ingest/run.mjs wp",
    "ingest:cli": "node scripts/ingest/run.mjs cli",
    "ingest:source": "node scripts/ingest/run.mjs source",
    "ingest:wpe": "node scripts/ingest/run.mjs wpe",
    "build:artifacts": "node scripts/build/run.mjs",
    "sync": "npm run ingest && npm run build:artifacts",
    "mcp": "node packages/mcp-server/src/index.mjs",
    "mcp:http": "node packages/mcp-server/src/http.mjs",
    "site:dev": "npm -w site run dev",
    "site:build": "npm -w site run build",
    "build": "npm -w site run build",
    "start": "node server/index.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:unit": "node --test test/unit.test.mjs test/blueprints.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs"
  },
  "dependencies": {
    "node-html-parser": "^7.0.1",
    "turndown": "^7.2.0",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://proven-lab.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThierryA/proven-lab"
  }
}
