---
import Base from '../layouts/Base.astro';
import { stats as getStats } from '../lib/data.mjs';
const stats = getStats();
const fmt = (n) => n.toLocaleString('en-US');
const why = [
  ['Efficiency', 'Reuse, don\'t regenerate', 'Users, permissions, content modeling, validation, media, cron, search. Reusing systems that already run at massive scale is cheaper, more reliable and far more scalable than asking an agent to rebuild them, and re-debug them, on every project.'],
  ['Mature ecosystem', 'Years of collective intelligence', 'Battle-tested code, a huge security research community and an established disclosure and patching process. An agent-written auth layer has none of that. WordPress core has all of it.'],
  ['Decoupled value', 'You don\'t need to love wp-admin', 'The value was never the admin screen. It is the core API layer underneath: registered post types, meta, capabilities, hooks, the REST API. Build your own admin and frontend in Node and never open wp-admin.'],
  ['Bridging the AI gap', 'Infrastructure agents can use', 'The WP Engine AI API adds what core doesn\'t: an AI gateway, a managed knowledge base for semantic search, agents and sessions, and an MCP server, all wired to your site.'],
];
const core = ['register_post_type', 'register_meta', 'register_taxonomy', 'WP_Query', 'capabilities & roles', 'add_action / add_filter', 'Abilities API', 'REST API', 'blocks & templates', 'cron & cache'];
const ai = ['AI Gateway', 'Knowledge Base', 'Agents & sessions', 'Site connector', 'MCP server', 'alt-text · summarize · taxonomy'];
const integrations = [
  ['MCP', 'Streamable HTTP + stdio', 'Ten tools: search, exact signatures, hooks, blueprints, AI API operations.', '/docs/connect'],
  ['OpenAPI', 'kit-api.yaml', 'For actions-style agents, plus the full AI API spec.', '/openapi/kit-api.yaml'],
  ['Function calling', 'OpenAI · Anthropic', 'Drop-in tool definitions for any agent framework.', '/tools/openai.json'],
  ['llms.txt', 'llms.txt · llms-full.txt', 'Context-ready docs and an AGENTS.md playbook.', '/llms.txt'],
];
const chip = 'rounded-md bg-white px-2 py-1 font-mono text-xs text-slate-700 ring-1 ring-slate-900/10 dark:bg-slate-900 dark:text-slate-300 dark:ring-white/10';
---
<Base title="Why pay agents to build from scratch? Build on a battle-tested platform · WP Agentic Kit">

<!-- Hero -->
<div class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 -top-40 -z-10 flex justify-center blur-3xl" aria-hidden="true">
    <div class="h-96 w-[60rem] bg-gradient-to-r from-sky-300/40 via-indigo-300/40 to-teal-200/40 dark:from-sky-500/20 dark:via-indigo-500/20 dark:to-teal-400/10"></div>
  </div>
  <div class="mx-auto max-w-[88rem] px-4 pb-20 pt-20 sm:px-6 lg:px-8">
    <p class="font-mono text-sm font-semibold text-sky-600 dark:text-sky-400">Developer kit · MCP · OpenAPI · llms.txt</p>
    <h1 class="mt-4 max-w-5xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white">
      Why pay agents to build software from scratch, <span class="bg-gradient-to-r from-sky-500 to-indigo-500 bg-clip-text text-transparent">professionally or vibe-coded,</span> when you can build on a battle-tested platform with worldwide collective intelligence?
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8">More efficient. Less costly. Secure and scalable. With maximum flexibility and extensibility. The WordPress core runtime API plus the WP Engine AI API give agents a proven foundation, and this kit gives them the docs and tools to use it.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/docs/connect" class="rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700 dark:bg-sky-500 dark:hover:bg-sky-400">Connect your agent</a>
      <a href="/docs/headless-node-app" class="rounded-full px-6 py-3 text-sm font-semibold text-slate-900 ring-1 ring-slate-900/10 hover:ring-slate-900/25 dark:text-white dark:ring-white/15 dark:hover:ring-white/30">Node app blueprint →</a>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-slate-900/10 ring-1 ring-slate-900/10 lg:grid-cols-4 dark:bg-white/10 dark:ring-white/10">
      {[[fmt(stats.functions), 'core functions documented'], [fmt(stats.hooks), 'actions & filters'], [String(stats.wpeOperations), 'AI API operations'], ['WP ' + stats.wordpress, 'generated from source']].map(([n, l]) => <div class="bg-white p-6 dark:bg-slate-950"><dt class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{n}</dt><dd class="mt-1 text-sm">{l}</dd></div>)}
    </dl>
  </div>
</div>

<!-- Why -->
<section id="why" class="mx-auto max-w-[88rem] px-4 pt-12 sm:px-6 lg:px-8">
  <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Why reuse beats regenerate</h2>
  <p class="mt-3 max-w-2xl text-lg">Agents are great at composing. They are expensive and risky when asked to reinvent a CMS, an auth system and a search engine on every project.</p>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {why.map(([k, h, p]) => <div class="rounded-2xl p-7 ring-1 ring-slate-900/10 transition hover:ring-sky-500/40 dark:ring-white/10 dark:hover:ring-sky-400/40">
      <p class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">{k}</p>
      <h3 class="mt-3 text-xl font-semibold tracking-tight text-slate-900 dark:text-white">{h}</h3>
      <p class="mt-2 leading-7">{p}</p></div>)}
  </div>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl bg-rose-50 p-7 ring-1 ring-rose-200 dark:bg-rose-500/5 dark:ring-rose-500/20">
      <p class="font-mono text-xs font-semibold uppercase tracking-wider text-rose-600 dark:text-rose-400">From scratch with an agent</p>
      <ul class="mt-4 space-y-2 text-sm"><li>Custom auth, roles, sessions: new attack surface</li><li>Hand-rolled content model and validation</li><li>Bespoke search and vector pipeline to host</li><li>Every project starts at zero, reviewed by no one else</li></ul></div>
    <div class="rounded-2xl bg-emerald-50 p-7 ring-1 ring-emerald-200 dark:bg-emerald-500/5 dark:ring-emerald-500/20">
      <p class="font-mono text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Core runtime API + AI API</p>
      <ul class="mt-4 space-y-2 text-sm"><li>Capabilities, application passwords, nonces: hardened for years</li><li>register_post_type, register_meta, Abilities: typed and permissioned</li><li>Managed knowledge base, gateway, agents and MCP</li><li>Open, portable, extensible with hooks</li></ul></div>
  </div>
</section>

<!-- Stack -->
<section id="stack" class="mx-auto max-w-[88rem] px-4 pt-28 sm:px-6 lg:px-8">
  <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Two APIs. One open stack.</h2>
  <p class="mt-3 max-w-2xl text-lg">Your UI can be Node, mobile or PHP templates. The value sits in the layers below it, and the docs keep them clearly separate.</p>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl bg-slate-50 p-6 text-center ring-1 ring-slate-900/10 md:col-span-2 dark:bg-slate-900/50 dark:ring-white/10">
      <p class="font-semibold text-slate-900 dark:text-white">Your experience</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">{['Node admin', 'Node frontend', 'PHP templates', 'Agents & MCP clients'].map((c) => <span class={chip}>{c}</span>)}</div></div>
    <a href="/docs/api/content-types" class="block rounded-2xl p-7 ring-1 ring-sky-500/30 transition hover:ring-sky-500 dark:ring-sky-400/30 dark:hover:ring-sky-400">
      <div class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-lg bg-sky-500/10 font-mono text-xs font-bold text-sky-600 dark:text-sky-400">PHP</span><h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Core Runtime API</h3></div>
      <p class="mt-2 text-sm">WordPress: the application layer. Runs on your site and owns data, users and logic.</p>
      <div class="mt-5 flex flex-wrap gap-2">{core.map((c) => <span class={chip}>{c}</span>)}</div></a>
    <a href="/docs/wpe/createChatCompletion" class="block rounded-2xl p-7 ring-1 ring-indigo-500/30 transition hover:ring-indigo-500 dark:ring-indigo-400/30 dark:hover:ring-indigo-400">
      <div class="flex items-center gap-3"><span class="grid size-8 place-items-center rounded-lg bg-indigo-500/10 font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400">AI</span><h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">AI API</h3></div>
      <p class="mt-2 text-sm">WP Engine: cloud infrastructure for search and AI. OpenAI-compatible HTTP.</p>
      <div class="mt-5 flex flex-wrap gap-2">{ai.map((c) => <span class={chip}>{c}</span>)}</div></a>
  </div>
</section>

<!-- Agents -->
<section id="agents" class="mx-auto max-w-[88rem] px-4 pt-28 sm:px-6 lg:px-8">
  <div class="grid items-start gap-10 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Docs written for agents, kept current automatically</h2>
      <p class="mt-3 text-lg">Not a handbook. Generated from WordPress core source, the developer handbooks and the live WP Engine AI OpenAPI spec, then served in every format agents consume.</p>
      <ol class="mt-8 space-y-5">
        {[['Ask', '"Create me a Node app with its own admin and frontend, using WordPress as the backend."'], ['Look up', 'The agent calls get_blueprint and get_function for exact core APIs, not guesses.'], ['Compose', 'register_post_type, register_meta, Abilities, REST. Plus the gateway and knowledge base.'], ['Ship', 'A real app on a proven stack. No wp-admin, no reinvented auth.']].map(([h, p], i) => <li class="flex gap-4"><span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-sky-500/10 font-mono text-xs font-bold text-sky-600 dark:text-sky-400">{i + 1}</span><div><p class="font-semibold text-slate-900 dark:text-white">{h}</p><p class="text-sm">{p}</p></div></li>)}
      </ol>
    </div>
    <div class="overflow-hidden rounded-2xl bg-slate-900 shadow-xl ring-1 ring-slate-900/10 dark:bg-slate-900 dark:ring-white/10">
      <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-3"><span class="size-3 rounded-full bg-slate-700"></span><span class="size-3 rounded-full bg-slate-700"></span><span class="size-3 rounded-full bg-slate-700"></span><span class="ml-3 font-mono text-xs text-slate-500">terminal</span></div>
      <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-7 text-slate-300"><span class="text-slate-500"># one line to give your agent WordPress superpowers</span>
<span class="text-sky-400">$</span> claude mcp add wp-agentic-kit -- npx wp-agentic-kit-mcp

<span class="text-sky-400">you ›</span> Create me a Node app that uses WordPress as
        the backend, custom admin included.
<span class="text-amber-300">agent</span> get_blueprint("headless-node-app")
<span class="text-amber-300">agent</span> get_function("register_meta") <span class="text-slate-500"># user meta</span>
<span class="text-amber-300">agent</span> get_wpe_operation("searchCollection")</pre>
    </div>
  </div>
  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {integrations.map(([k, h, p, href]) => <a href={href} class="block rounded-2xl p-6 ring-1 ring-slate-900/10 hover:ring-sky-500/40 dark:ring-white/10 dark:hover:ring-sky-400/40"><p class="font-mono text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">{k}</p><h3 class="mt-2 font-semibold text-slate-900 dark:text-white">{h}</h3><p class="mt-1 text-sm">{p}</p></a>)}
  </div>
</section>

<!-- CTA -->
<section class="mx-auto max-w-[88rem] px-4 pt-28 sm:px-6 lg:px-8">
  <div class="relative overflow-hidden rounded-3xl bg-slate-900 px-8 py-16 text-center dark:bg-slate-900 dark:ring-1 dark:ring-white/10">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-sky-500/20 via-transparent to-indigo-500/20"></div>
    <h2 class="relative text-3xl font-bold tracking-tight text-white sm:text-4xl">An open, flexible stack that competes on what matters</h2>
    <p class="relative mx-auto mt-3 max-w-xl text-slate-300">Proven core APIs, purpose-built AI infrastructure, and agents that build with both.</p>
    <div class="relative mt-8 flex justify-center gap-3"><a href="/docs/connect" class="rounded-full bg-sky-500 px-6 py-3 text-sm font-semibold text-white hover:bg-sky-400">Get started</a><a href="/docs" class="rounded-full px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/20 hover:ring-white/40">Browse the docs</a></div>
  </div>
</section>
</Base>
