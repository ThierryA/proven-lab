---
import Docs from '../../../layouts/Docs.astro';
import { wpe } from '../../../lib/data.mjs';
import { md } from '../../../lib/md.mjs';
const inline = (t) => md.parseInline(t || '');
export function getStaticPaths() { return wpe().operations.map((o) => ({ params: { op: o.operationId }, props: { o } })); }
const { o } = Astro.props;
const { components } = wpe();
// Resolve local $refs so the page shows real field names and types.
const deref = (s, depth = 0) => {
  if (!s || depth > 6) return s;
  if (s.$ref) { const [, kind, name] = s.$ref.match(/^#\/components\/(\w+)\/(.+)$/) || []; return deref(components?.[kind]?.[name], depth + 1); }
  if (s.allOf) return s.allOf.map((x) => deref(x, depth + 1)).reduce((a, b) => ({ ...a, ...b, properties: { ...(a.properties || {}), ...(b.properties || {}) }, required: [...(a.required || []), ...(b.required || [])] }), {});
  return s;
};
const typeOf = (p) => { const r = deref(p) || {}; return r.type === 'array' ? `${typeOf(r.items) || 'any'}[]` : r.type || (r.oneOf || r.anyOf ? 'one of several' : r.enum ? 'enum' : ''); };
const params = (o.parameters || []).map((p) => deref(p)).map((p) => ({ name: p.name, in: p.in, required: p.required, type: typeOf(p.schema), description: p.description }));
const body = deref(o.requestBody?.content?.['application/json']?.schema);
const fields = body?.properties ? Object.entries(body.properties).map(([name, p]) => ({ name, type: typeOf(p), required: (body.required || []).includes(name), description: deref(p)?.description || '' })) : [];
const responses = Object.entries(o.responses || {}).map(([code, r]) => ({ code, description: deref(r)?.description || '' }));
const raw = (o.tags || []).find((x) => !x.startsWith('Product'));
const group = raw === 'Sites' ? 'Site connection' : raw;
---
<Docs title={o.operationId} description={o.summary}>
  <p class="label mb-4">Cloud AI API · {group}</p>
  <article class="prose prose-lab">
    <h1>{o.operationId}</h1>
    <p class="lead">{o.summary}</p>
    <pre><code>{o.method} https://api.ai.wpengine.com{o.path}</code></pre>
    {raw === 'Sites' && <p>Site connection operations are called by the WP Engine AI plugin with the site's own OAuth credentials, not with an API key. See <a href="/docs/ai-features">AI features</a>.</p>}
    {o.description && <div set:html={md.parse(o.description)} />}
    {params.length > 0 && <><h2>Parameters</h2><table><thead><tr><th>Name</th><th>In</th><th>Type</th><th>Description</th></tr></thead><tbody>{params.map((p) => <tr><td><code>{p.name}</code>{p.required ? ' (required)' : ''}</td><td>{p.in}</td><td>{p.type}</td><td set:html={inline(p.description)} /></tr>)}</tbody></table></>}
    {fields.length > 0 && <><h2>Request body</h2><table><thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead><tbody>{fields.map((f) => <tr><td><code>{f.name}</code>{f.required ? ' (required)' : ''}</td><td>{f.type}</td><td set:html={inline(f.description)} /></tr>)}</tbody></table></>}
    {responses.length > 0 && <><h2>Responses</h2><table><tbody>{responses.map((r) => <tr><td><code>{r.code}</code></td><td set:html={inline(r.description)} /></tr>)}</tbody></table></>}
    <p class="text-sm">Full schema: <code>get_ai_operation {o.operationId}</code>. Reference: <a href={`https://developers.wpengine.com/docs/ai/api/reference/operations/${o.operationId.toLowerCase()}/`}>WP Engine docs</a>.</p>
  </article>
</Docs>
