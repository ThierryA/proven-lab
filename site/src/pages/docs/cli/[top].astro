---
import Docs from '../../../layouts/Docs.astro';
import { cli } from '../../../lib/data.mjs';
import { render } from '../../../lib/md.mjs';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
export function getStaticPaths() { return cli().tops.map((t) => ({ params: { top: t.top }, props: { t } })); }
const { t } = Astro.props;
const md = readFileSync(join(process.cwd(), '..', 'dist', 'cli', `${t.top}.md`), 'utf8').replace(/^# .*\n+/, '');
---
<Docs title={`wp ${t.top}`} description={t.description}>
  <p class="label mb-4">WP-CLI {cli().version}</p>
  <article class="prose prose-lab">
    <h1><code>wp {t.top}</code></h1><p class="lead">{t.description}</p>
    <p class="text-sm">{t.count} {t.count === 1 ? 'command' : 'commands'}. Exact flags: the <code>get_cli_command</code> MCP tool. See also <a href="/docs/wp-cli-for-agents">WP-CLI for agents</a>.</p>
    <div set:html={render(md)} />
  </article>
</Docs>
