---
import Docs from '../../layouts/Docs.astro';
import { blueprints, overviews, connectMd, runbookMd, domains, sidebar, GROUP_ORDER } from '../../lib/data.mjs';
import { render } from '../../lib/md.mjs';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
export function getStaticPaths() {
  return [...blueprints().map((b) => ({ params: { slug: b.slug }, props: { kind: 'Guide', slug: b.slug, title: b.title, does: b.agent_does, you: b.you_do, md: b.md.replace(/^\s*# .*\n/, '') } })),
    ...overviews().map((o) => ({ params: { slug: o.slug }, props: { kind: 'Overview', slug: o.slug, title: o.title, md: o.md } })),
    { params: { slug: 'connect' }, props: { kind: 'Guide', title: 'Use your agent', md: connectMd() } },
    { params: { slug: 'runbook' }, props: { kind: 'Runbook · the same text as /AGENTS.md', title: 'Runbook for agents', md: runbookMd() } }];
}
const { kind, slug, title, md, does, you } = Astro.props;
// Guides show people a short summary; the full instructions (what agents read) sit below, collapsed.
const isGuide = Array.isArray(does);
const openByDefault = slug === 'architecture';
const sb = sidebar();
const row = 'grid grid-cols-[minmax(0,13rem)_1fr] gap-6 border-b border-line py-3 text-[14px] no-underline hover:bg-ink-2';
// Pages can mark a text diagram (kept for agents) that the site replaces with the visual one.
const [before, rest] = md.split('<!-- diagram:start -->');
const after = rest?.split('<!-- diagram:end -->')[1];
const prose = 'prose prose-lab';
---
<Docs title={title}>
  <p class="label mb-4">{kind}</p>
  {isGuide && <>
    <h1 class="text-[2.1rem] font-medium leading-tight tracking-[-0.02em] text-fg">{title}</h1>
    <div class="mt-8 grid border-t border-l border-line sm:grid-cols-2">
      <div class="border-r border-b border-line p-5"><p class="label">What your agent does</p><ul class="mt-3 space-y-2 text-[14px] leading-relaxed">{does.map((d) => <li class="flex gap-2"><span class="text-signal">›</span><span>{d}</span></li>)}</ul></div>
      <div class="border-r border-b border-line p-5"><p class="label">What you do</p><ul class="mt-3 space-y-2 text-[14px] leading-relaxed text-fg">{you.map((d) => <li class="flex gap-2"><span class="text-fg-3">·</span><span>{d}</span></li>)}</ul></div>
    </div>
    <p class="mt-4 text-[13px] text-fg-3">You don't run any of the steps below: your agent reads them and does the work. <a class="text-fg-2 underline decoration-line-2 underline-offset-4 hover:decoration-signal" href="/docs/connect">Use your agent</a></p>
  </>}
  {isGuide
    ? <details class="agent-steps mt-10 border-t border-line pt-6" open={openByDefault || undefined}>
        <summary class="label flex cursor-pointer list-none items-center gap-2 hover:text-fg-2 [&::-webkit-details-marker]:hidden"><span class="transition [details[open]_&]:rotate-90">›</span>Instructions your agent follows</summary>
        {after === undefined ? <article class={prose + ' mt-6'} set:html={render(md)} /> : (
          <article class="mt-6"><div class={prose} set:html={render(before)} /><div class="my-10"><ArchitectureDiagram /></div><div class={prose} set:html={render(after)} /></article>
        )}
      </details>
    : after === undefined ? <article class={prose} set:html={render(md)} /> : (
      <article><div class={prose} set:html={render(before)} /><div class="my-10"><ArchitectureDiagram /></div><div class={prose} set:html={render(after)} /></article>
    )}
  {slug === 'core-api' && GROUP_ORDER.map((g) => <><h3 class="label mt-10">{g}</h3><div class="mt-2 border-t border-line">{domains().filter((d) => d.group === g).map((d) => <a class={row} href={`/docs/api/${d.slug}`}><span class="text-fg">{d.title}</span><span>{d.summary}</span></a>)}</div></>)}
  {slug === 'cloud-ai-api' && <><h3 class="label mt-10">All operations</h3><div class="mt-2 border-t border-line">{[...sb.ai, null, ...sb.account].map((g) => g === null ? <div class="border-b border-dashed border-line-2" role="separator"></div> : <a class={row} href={g.items[0].href}><span class="text-fg">{g.title}</span><span class="font-mono text-[12px] text-fg-3">{g.items.map((i) => i.label).join(' · ')}</span></a>)}</div></>}
</Docs>
