---
import Docs from '../../layouts/Docs.astro';
import { marked } from 'marked';
import { blueprints, connectMd } from '../../lib/data.mjs';
export function getStaticPaths() {
  return [...blueprints().map((b) => ({ params: { slug: b.slug }, props: { title: b.title, md: `# ${b.title}\n\n` + b.md.replace(/^# .*\n/, '') } })),
    { params: { slug: 'connect' }, props: { title: 'Connect your agent', md: connectMd() } }];
}
const { title, md } = Astro.props;
---
<Docs title={title}><article class="prose prose-slate max-w-none dark:prose-invert" set:html={marked.parse(md)} /></Docs>
