---
const { title = 'WP Agentic Kit', description = 'Build AI experiences on WordPress core APIs and the WP Engine AI API.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <style is:global>
    :root{--bg:#07080c;--panel:#0d1017;--line:#1c2230;--text:#e8ebf2;--mute:#8b94a7;--accent:#5eead4;--accent2:#818cf8;--warm:#fbbf24;--mono:ui-monospace,SFMono-Regular,Menlo,monospace}
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 Inter,system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
    code,pre{font-family:var(--mono)}
    .wrap{max-width:1120px;margin:0 auto;padding:0 24px}
    nav.top{position:sticky;top:0;z-index:10;backdrop-filter:blur(12px);background:rgba(7,8,12,.75);border-bottom:1px solid var(--line)}
    nav.top .wrap{display:flex;align-items:center;gap:28px;height:60px}
    nav.top .brand{font-weight:700;color:var(--text);letter-spacing:-.01em}
    nav.top .brand span{color:var(--accent)}
    nav.top a.l{color:var(--mute);font-size:14px}nav.top a.l:hover{color:var(--text);text-decoration:none}
    .sp{flex:1}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:10px;font-weight:600;font-size:15px;border:1px solid var(--line);color:var(--text);background:var(--panel)}
    .btn.primary{background:var(--accent);color:#04201c;border-color:var(--accent)}.btn:hover{text-decoration:none;filter:brightness(1.1)}
    .md{max-width:820px}.md h1{font-size:2.2rem;letter-spacing:-.02em}.md h2{margin-top:2.4rem;border-top:1px solid var(--line);padding-top:1.4rem}
    .md pre{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px;overflow:auto;font-size:13px}
    .md code{background:var(--panel);padding:2px 6px;border-radius:5px;font-size:.88em}.md pre code{background:none;padding:0}
    .md table{border-collapse:collapse;width:100%;font-size:14px}.md th,.md td{border:1px solid var(--line);padding:8px 12px;text-align:left;vertical-align:top}.md th{background:var(--panel)}
    footer{border-top:1px solid var(--line);color:var(--mute);font-size:14px;padding:40px 0;margin-top:80px}
  </style>
</head>
<body>
<nav class="top"><div class="wrap">
  <a class="brand" href="/">WP<span>·</span>Agentic Kit</a>
  <a class="l" href="/#why">Why</a><a class="l" href="/#stack">Stack</a><a class="l" href="/#agents">For agents</a><a class="l" href="/docs">Docs</a>
  <span class="sp"></span><a class="btn primary" href="/docs/connect">Connect your agent</a>
</div></nav>
<slot />
<footer><div class="wrap">Docs generated from WordPress source and the live WP Engine AI API spec · <a href="/llms.txt">llms.txt</a> · <a href="/openapi/kit-api.yaml">OpenAPI</a> · <a href="/tools/openai.json">OpenAI tools</a></div></footer>
</body></html>
