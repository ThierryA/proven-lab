---
import Base from './Base.astro';
import { sidebar } from '../lib/data.mjs';
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const sb = sidebar();
const on = (href) => path === href;
const open = (items) => items.some((i) => on(i.href));
const link = (active) => `-ml-px block border-l py-1 pl-3 text-[13px] ${active ? 'border-signal text-fg' : 'border-transparent text-fg-2 hover:border-line-2 hover:text-fg'}`;
const sections = [
  { tag: 'PHP', title: 'Core Runtime API', blurb: 'WordPress core PHP APIs, by task area.', overview: '/docs/core-runtime-api', groups: sb.core },
  { tag: 'CLI', title: 'WP-CLI', blurb: 'The wp command. How coding agents verify and administer.', overview: '/docs/wp-cli-for-agents', groups: sb.cli },
  { tag: 'AI', title: 'Cloud AI API', blurb: 'Gateway, knowledge base, agents and sessions.', overview: '/docs/cloud-ai-api', groups: sb.ai, after: sb.account },
  { tag: 'WPE', title: 'Deployment', blurb: 'WP Engine. Optional, recommended.', overview: '/docs/wpe-deployment', groups: [] },
];
---
<Base title={`${title} · Proven Lab`} description={description}>
<div class="mx-auto flex max-w-[90rem] px-5 sm:px-8">
  <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-64 shrink-0 overflow-y-auto border-r border-line py-8 pr-6 lg:block" aria-label="Documentation">
    <p class="label">Guides</p>
    <ul class="mt-3 border-l border-line">{sb.guides.map((i) => <li><a href={i.href} class={link(on(i.href))}>{i.label}</a></li>)}</ul>
    {sections.map((sec) => (
      <div class="mt-9 border-t border-line pt-5">
        <p class="flex items-baseline gap-2 text-[13px] text-fg"><span class="font-mono text-[10px] text-fg-3">{sec.tag}</span>{sec.title}</p>
        <p class="mt-1 text-[12px] leading-snug text-fg-3">{sec.blurb}</p>
        <ul class="mt-3 border-l border-line"><li><a href={sec.overview} class={link(on(sec.overview))}>Overview</a></li></ul>
        {[...sec.groups, ...(sec.after ? [null, ...sec.after] : [])].map((g) => g === null
          ? <div class="mt-4 border-t border-dashed border-line-2" role="separator"></div>
          : <details class="group mt-3" open={open(g.items) || undefined}>
              <summary class="label flex cursor-pointer list-none items-center gap-1.5 hover:text-fg-2 [&::-webkit-details-marker]:hidden"><span class="transition group-open:rotate-90">›</span>{g.title}</summary>
              <ul class="mt-1.5 border-l border-line">{g.items.map((i) => <li><a href={i.href} class={link(on(i.href))}>{i.method && <span class="mr-1.5 font-mono text-[10px] text-fg-3">{i.method}</span>}{i.label}</a></li>)}</ul>
            </details>)}
      </div>
    ))}
  </aside>
  <main class="min-w-0 flex-1 py-12 lg:pl-12 xl:pr-10"><div class="mx-auto max-w-3xl"><slot /></div></main>
  <nav id="toc" class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-52 shrink-0 overflow-y-auto py-12 pl-4 xl:block"><p class="label">On this page</p><ul id="toc-list" class="mt-3 space-y-1.5 text-[12px]"></ul></nav>
</div>
<script is:inline>
  const list = document.getElementById('toc-list');
  document.querySelectorAll('article h2, article h3').forEach((h, i) => {
    if (!h.id) h.id = 'h-' + i + '-' + h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const li = document.createElement('li'); li.className = h.tagName === 'H3' ? 'pl-3' : '';
    li.innerHTML = '<a class="block truncate text-fg-3 hover:text-fg" href="#' + h.id + '"></a>';
    li.firstChild.textContent = h.textContent.replace(/\(\)$/, ''); list.appendChild(li);
  });
  if (!list.children.length) document.getElementById('toc').remove();
</script>
</Base>
