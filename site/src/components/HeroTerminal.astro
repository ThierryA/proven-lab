---
// Hero panel: the message as agent sessions in a terminal, looping between building a new app
// and updating an existing site. The first session is rendered complete on the server
// (no-JS, reduced motion, crawlers); the script types the sessions at reading pace, in a loop.
type Row = { kind: 'you' | 'agent' | 'out' | 'label'; text?: string; html?: string };
const INDUSTRY: Row = { kind: 'label', html: '# current industry' };
const FIX: Row = { kind: 'label', html: '# the fix: <span class="t-sig">Proven Lab</span>' };
const sessions: Row[][] = [
  [
    { kind: 'you', text: 'Build me an app with users, content and search.' },
    INDUSTRY,
    { kind: 'agent', text: 'Rebuilds auth, roles, admin, REST API and search from scratch.' },
    { kind: 'out', html: '<span class="t-x">✗</span> slow   <span class="t-x">✗</span> costly   <span class="t-x">✗</span> unreviewed   <span class="t-x">✗</span> insecure   <span class="t-x">✗</span> not scalable' },
    FIX,
    { kind: 'agent', text: 'Builds on the platform instead.' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">Core API    </span> content, users, permissions, hooks, REST' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">WP-CLI      </span> every step verified from the shell' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">Cloud AI API</span> models, search and agents, no API key' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">Deployment  </span> WP Engine, optional: managed hosting, Headless Platform' },
    { kind: 'agent', text: 'Done. Only the code specific to your app was written.' },
    { kind: 'out', html: '<span class="t-sig">reliable · secure · scalable · efficient · lower cost</span>' },
  ],
  [
    { kind: 'you', text: 'Add a members area to my existing site.' },
    INDUSTRY,
    { kind: 'agent', text: 'Rewrites the site in a new stack first.' },
    { kind: 'out', html: '<span class="t-x">✗</span> migration   <span class="t-x">✗</span> lost content   <span class="t-x">✗</span> downtime' },
    FIX,
    { kind: 'agent', text: 'Extends what is already there instead.' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">Core API    </span> roles, capabilities, user fields' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">WP-CLI      </span> checked on staging before production' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">Cloud AI API</span> member search over your content' },
    { kind: 'out', html: '<span class="t-ok">✓</span> <span class="t-key">Deployment  </span> WP Engine, optional: staging first, then production' },
    { kind: 'agent', text: 'Done. Existing content, users and plugins kept.' },
    { kind: 'out', html: '<span class="t-sig">reliable · secure · scalable · efficient · lower cost</span>' },
  ],
];
const prompt = { you: 'you ›', agent: 'agent ›' } as const;
---
<figure class="hero-term not-prose" aria-label="A coding agent building a new app, or updating an existing site, on the platform" data-hero-term data-sessions={JSON.stringify(sessions)}>
  <div class="border border-line-2 bg-ink-2/95 backdrop-blur-sm">
    <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5">
      <span class="size-2 rounded-full bg-line-2"></span><span class="size-2 rounded-full bg-line-2"></span><span class="size-2 rounded-full bg-line-2"></span>
      <span class="ml-3 font-mono text-[11px] text-fg-3" data-term-title>agent session · build</span>
    </div>
    <div class="t-screen space-y-1.5 scroll-smooth px-5 py-5 font-mono text-[12px] leading-[1.7] sm:text-[13px] xl:px-7 xl:text-[14px]" data-term-screen>
      {sessions[0].map((r) => (
        <div class={`t-row t-${r.kind}`}>
          {(r.kind === 'you' || r.kind === 'agent') && <span class="t-prompt">{prompt[r.kind]}</span>}
          {r.html ? <span class="t-body" set:html={r.html} /> : <span class="t-body">{r.text}</span>}
        </div>
      ))}
    </div>
  </div>
</figure>

<style is:global>
  .hero-term .t-screen { height: 20.5em; overflow-y: auto; scrollbar-width: none; transition: opacity 0.6s ease; }
  .hero-term .t-screen::-webkit-scrollbar { display: none; }
  .hero-term .t-screen.is-clearing { opacity: 0; }
  .hero-term .t-row { display: flex; gap: 0.75ch; white-space: pre-wrap; animation: term-in 0.5s ease-out both; }
  .hero-term .t-out { padding-left: 8ch; color: var(--color-fg-2); }
  .hero-term .t-label { color: var(--color-fg-3); margin-top: 0.6em; }
  .hero-term .t-you .t-body { color: var(--color-fg); }
  .hero-term .t-agent .t-body { color: var(--color-fg-2); }
  .hero-term .t-prompt { flex: none; width: 7ch; color: var(--color-fg-3); }
  .hero-term .t-you .t-prompt { color: var(--color-signal); }
  .hero-term .t-ok { color: var(--color-fg-3); }
  .hero-term .t-x { color: var(--color-signal); }
  .hero-term .t-key { color: var(--color-fg); white-space: pre; }
  .hero-term .t-sig { color: var(--color-signal); }
  .hero-term .t-caret::after { content: '▍'; color: var(--color-signal); animation: term-blink 1s steps(1) infinite; }
  @keyframes term-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes term-blink { 50% { opacity: 0; } }
  @media (max-width: 640px) { .hero-term .t-out { padding-left: 2ch; } .hero-term .t-prompt { width: auto; } .hero-term .t-screen { height: 24em; } }
  @media (prefers-reduced-motion: reduce) { .hero-term .t-row { animation: none; } }
</style>

<script>
  type Row = { kind: 'you' | 'agent' | 'out' | 'label'; text?: string; html?: string };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const PROMPT = { you: 'you ›', agent: 'agent ›' };
  const TITLES = ['agent session · build', 'agent session · update'];

  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-term]')) {
    if (reduce) continue;
    const sessions: Row[][] = JSON.parse(root.dataset.sessions || '[]');
    const screen = root.querySelector<HTMLElement>('[data-term-screen]')!;
    const title = root.querySelector<HTMLElement>('[data-term-title]')!;
    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);

    // Sleep that stands still while the panel is off-screen or the tab is hidden.
    const sleep = async (ms: number) => {
      while (ms > 0) { await new Promise((r) => setTimeout(r, 50)); if (visible && !document.hidden) ms -= 50; }
    };
    const follow = () => { screen.scrollTop = screen.scrollHeight; };
    const row = (r: Row) => {
      const el = document.createElement('div');
      el.className = `t-row t-${r.kind}`;
      if (r.kind === 'you' || r.kind === 'agent') { const p = document.createElement('span'); p.className = 't-prompt'; p.textContent = PROMPT[r.kind]; el.appendChild(p); }
      const body = document.createElement('span'); body.className = 't-body'; el.appendChild(body);
      return { el, body };
    };

    (async () => {
      await sleep(1200);
      for (let n = 0; ; n = (n + 1) % sessions.length) {
        screen.classList.add('is-clearing');
        await sleep(600);
        screen.innerHTML = '';
        title.textContent = TITLES[n] || TITLES[0];
        screen.classList.remove('is-clearing');
        await sleep(400);
        for (const r of sessions[n]) {
          const { el, body } = row(r);
          screen.appendChild(el);
          follow();
          if (r.kind === 'out' || r.kind === 'label') { body.innerHTML = r.html || ''; follow(); await sleep(r.kind === 'label' ? 900 : 800); continue; }
          const text = r.text || '';
          body.classList.add('t-caret');
          const speed = r.kind === 'you' ? 45 : 26;
          for (let i = 1; i <= text.length; i++) { body.textContent = text.slice(0, i); follow(); await sleep(speed); }
          body.classList.remove('t-caret');
          await sleep(r.kind === 'you' ? 1000 : 700);
        }
        await sleep(5000);
      }
    })();
  }
</script>
