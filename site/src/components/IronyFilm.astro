---
// "A short film about agents, in three acts." A code-driven film: text-only, ~30 s, loops.
// Plays when in view, pauses when hidden; reduced motion shows a static storyboard.
---
<figure class="film not-prose" data-film aria-label="A short film about agents, in three acts">
  <div class="relative aspect-[4/5] w-full overflow-hidden sm:aspect-[16/9] border border-line-2 bg-ink-2 bg-[radial-gradient(var(--color-line)_1px,transparent_1px)] bg-[size:14px_14px]">
    <div class="absolute inset-x-0 top-0 flex items-center justify-between border-b border-line bg-ink/80 px-4 py-2 font-mono text-[11px] text-fg-3">
      <span data-film-act>agent.log</span>
      <span data-film-time>00:00</span>
    </div>
    <div class="absolute inset-0 top-9 overflow-hidden px-6 py-5 font-mono text-[clamp(11px,1.35vw,15px)] leading-[1.75] text-fg-2 sm:px-10 sm:py-8" data-film-screen aria-live="off"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-line"><div class="h-px w-0 bg-signal" data-film-progress></div></div>
  </div>
  <figcaption class="mt-3 flex items-center gap-4 font-mono text-[11px] text-fg-3">
    <button type="button" data-film-toggle class="border border-line-2 px-2.5 py-1 text-fg-2 hover:border-fg-3 hover:text-fg">Pause</button>
    <button type="button" data-film-replay class="px-1 py-1 hover:text-fg">Replay</button>
    <span class="ml-auto">A short film about agents, in three acts.</span>
  </figcaption>
</figure>

<style is:global>
  .film .ln { white-space: pre-wrap; }
  .film .dim { color: var(--color-fg-3); }
  .film .hi { color: var(--color-fg); }
  .film .sig { color: var(--color-signal); }
  .film .ok::before { content: '✓ '; color: var(--color-fg-3); }
  .film .no::before { content: '✗ '; color: var(--color-signal); }
  .film .title { font-family: var(--font-sans); color: var(--color-fg); letter-spacing: -0.02em; }
  .film .title.sig { color: var(--color-signal); }
  .film .caret::after { content: '▍'; color: var(--color-signal); animation: film-blink 1s steps(1) infinite; }
  .film .counter { font-variant-numeric: tabular-nums; }
  @keyframes film-blink { 50% { opacity: 0; } }
</style>

<script>
  type Line = { text: string; cls?: string; type?: boolean; pause?: number };
  type Scene = { act: string; lines: Line[]; counters?: { lines: number; tokens: number; bugs: number }; hold?: number; title?: boolean };

  const SCENES: Scene[] = [
    { act: 'title', title: true, hold: 2200, lines: [
      { text: 'A short film about agents', cls: 'title text-[1.9em] block' },
      { text: 'in three acts', cls: 'dim' },
    ] },
    { act: 'act I · from scratch', counters: { lines: 41870, tokens: 2.9, bugs: 17 }, hold: 1800, lines: [
      { text: 'user › Build me an app with users, content and search.', cls: 'hi', type: true, pause: 600 },
      { text: 'agent › On it. Starting from zero.', cls: 'dim', type: true, pause: 400 },
      { text: 'users table', cls: 'ok' },
      { text: 'password hashing (custom, probably fine)', cls: 'ok' },
      { text: 'roles and permissions v1', cls: 'ok' },
      { text: 'roles and permissions v2 (v1 let everyone edit everything)', cls: 'ok' },
      { text: 'admin panel', cls: 'ok' },
      { text: 'REST API', cls: 'ok' },
      { text: 'media uploads', cls: 'ok' },
      { text: "search: WHERE title LIKE '%...%'", cls: 'ok' },
      { text: 'security review: skipped, deadline', cls: 'no', pause: 900 },
    ] },
    { act: 'act II · meanwhile', hold: 2600, lines: [
      { text: 'Every line above already exists.', cls: 'title text-[1.35em] block', pause: 900 },
      { text: 'users, roles, permissions   → WordPress core', cls: 'hi' },
      { text: 'admin panel                 → WP Admin, or your own', cls: 'hi' },
      { text: 'REST API, media             → WordPress core', cls: 'hi' },
      { text: 'search, AI                  → Cloud AI API', cls: 'hi' },
      { text: '', pause: 200 },
      { text: 'Two decades of production use. Reviewed in public.', cls: 'dim' },
    ] },
    { act: 'act III · with Proven Lab', counters: { lines: 12, tokens: 0.04, bugs: 0 }, hold: 2200, lines: [
      { text: 'user › Build me an app with users, content and search.', cls: 'hi', type: true, pause: 400 },
      { text: 'agent › get_blueprint("architecture") · get_function("register_meta")', cls: 'dim', type: true, pause: 300 },
      { text: "register_post_type( 'project', array( 'show_in_rest' => true ) );", cls: 'hi', type: true },
      { text: "register_meta( 'user', 'job_title', array( 'show_in_rest' => true ) );", cls: 'hi', type: true },
      { text: "wp_register_ability( 'app/archive-project', $args );", cls: 'hi', type: true, pause: 500 },
      { text: 'done. verified with wp-cli.', cls: 'sig' },
    ] },
    { act: 'fin', title: true, hold: 3200, lines: [
      { text: 'Why pay agents to rebuild a battle-tested platform?', cls: 'title text-[1.6em] block' },
      { text: 'Instead, build on top of it.', cls: 'title text-[1.6em] block sig' },
      { text: '', pause: 200 },
      { text: 'Proven Lab', cls: 'dim' },
    ] },
  ];

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-film]')) {
    const screen = root.querySelector<HTMLElement>('[data-film-screen]')!;
    const actEl = root.querySelector<HTMLElement>('[data-film-act]')!;
    const timeEl = root.querySelector<HTMLElement>('[data-film-time]')!;
    const bar = root.querySelector<HTMLElement>('[data-film-progress]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-film-toggle]')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-film-replay]')!;

    let paused = false, inView = false, run = 0, elapsed = 0, started = false;
    const TOTAL = 32000;

    const line = (l: Line) => { const el = document.createElement('div'); el.className = `ln ${l.cls || ''}`; return el; };
    const counterRow = () => {
      const el = document.createElement('div');
      el.className = 'counter dim mt-4 border-t border-line pt-3 text-[0.85em]';
      el.innerHTML = 'lines written <span class="hi" data-c="lines">0</span> · tokens <span class="hi" data-c="tokens">0</span>M · bugs <span class="sig" data-c="bugs">0</span>';
      return el;
    };

    // Waits that respect pause and abort on replay.
    const wait = async (ms: number, id: number) => {
      let left = ms;
      while (left > 0) {
        if (id !== run) throw new Error('stop');
        const step = Math.min(left, 50);
        await new Promise((r) => setTimeout(r, step));
        if (!paused && inView && !document.hidden) { left -= step; elapsed += step; tick(); }
      }
    };
    const tick = () => {
      const s = Math.floor(elapsed / 1000);
      timeEl.textContent = `00:${String(Math.min(s, 59)).padStart(2, '0')}`;
      bar.style.width = `${Math.min(100, (elapsed / TOTAL) * 100)}%`;
    };

    const play = async () => {
      const id = ++run; elapsed = 0; tick();
      try {
        for (;;) {
          for (const scene of SCENES) {
            screen.innerHTML = ''; actEl.textContent = scene.act === 'title' || scene.act === 'fin' ? 'agent.log' : scene.act;
            screen.classList.toggle('flex', !!scene.title); screen.classList.toggle('flex-col', !!scene.title); screen.classList.toggle('justify-center', !!scene.title);
            let counters: HTMLElement | null = null;
            for (const [i, l] of scene.lines.entries()) {
              const el = line(l); screen.appendChild(el);
              if (l.type) {
                el.classList.add('caret');
                for (let c = 1; c <= l.text.length; c += 2) { el.textContent = l.text.slice(0, c); await wait(18, id); }
                el.textContent = l.text; el.classList.remove('caret');
              } else { el.textContent = l.text; }
              if (scene.counters) {
                if (!counters) { counters = counterRow(); screen.appendChild(counters); }
                screen.appendChild(counters);
                const p = (i + 1) / scene.lines.length;
                const set = (k: string, v: string) => { counters!.querySelector<HTMLElement>(`[data-c="${k}"]`)!.textContent = v; };
                set('lines', Math.round(scene.counters.lines * p).toLocaleString('en-US'));
                set('tokens', (scene.counters.tokens * p).toFixed(scene.counters.tokens < 1 ? 2 : 1));
                set('bugs', String(Math.round(scene.counters.bugs * p)));
              }
              await wait(l.pause ?? (scene.title ? 500 : 420), id);
            }
            await wait(scene.hold ?? 1500, id);
          }
          elapsed = 0;
        }
      } catch { /* replay or stop */ }
    };

    const storyboard = () => {
      screen.innerHTML = SCENES.filter((s) => !s.title).map((s) => `<div class="ln sig mt-3">${s.act}</div>` + s.lines.slice(0, 4).map((l) => `<div class="ln ${l.cls || ''}">${l.text.replace(/</g, '&lt;')}</div>`).join('')).join('');
      screen.style.fontSize = '11px'; screen.classList.add('overflow-y-auto');
      root.querySelector('figcaption')!.querySelectorAll('button').forEach((b) => (b.hidden = true));
      bar.style.width = '100%';
    };

    if (reduce) { storyboard(); continue; }

    toggle.addEventListener('click', () => { paused = !paused; toggle.textContent = paused ? 'Play' : 'Pause'; });
    replay.addEventListener('click', () => { paused = false; toggle.textContent = 'Pause'; play(); });
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; if (inView && !started) { started = true; play(); } }, { threshold: 0.35 }).observe(root);
  }
</script>
