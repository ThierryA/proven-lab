---
// Hero panel: the message as annotated code. Each comment carries one claim from the hero
// sentence; the code under it is the real WordPress call that backs it. Lines reveal once (CSS only).
type Item = { claim: string; why: string; code: string };
const items: Item[] = [
  { claim: 'reliable', why: '20+ years of production use', code: "register_post_type( 'project', $args );" },
  { claim: 'efficient', why: 'typed, validated, in the REST API', code: "register_meta( 'user', 'job_title', $args );" },
  { claim: 'secure', why: 'capabilities, reviewed in public', code: "current_user_can( 'edit_post', $post_id );" },
  { claim: 'scalable', why: 'object cache API, Redis or Memcached', code: 'wp_cache_set( $key, $value );' },
  { claim: 'lower cost', why: 'Cloud AI API, no API key', code: "wp_ai_client_prompt( $q )->using_provider( 'wpengine' );" },
];
const notWritten = ['auth', 'roles', 'admin', 'REST API', 'media', 'search'];

// Minimal PHP colouring in the site's code theme.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const colour = (code: string) =>
  esc(code).replace(/('[^']*')|(\$[a-z_]+)|([a-z_]+)(?=\()|(-&gt;)|([();,])/gi, (m, str, v, fn, arrow, p) =>
    str ? `<span class="c-str">${str}</span>` : v ? `<span class="c-var">${v}</span>` : fn ? `<span class="c-fn">${fn}</span>` : arrow ? `<span class="c-pun">${arrow}</span>` : `<span class="c-pun">${p}</span>`);

let i = 0;
---
<figure class="hero-code not-prose" aria-label="What a coding agent writes on Proven Lab">
  <div class="border border-line-2 bg-ink-2/95 backdrop-blur-sm">
    <div class="flex items-center justify-between border-b border-line px-4 py-2 font-mono text-[11px] text-fg-3">
      <span>app.php</span><span>what your agent writes</span>
    </div>
    <pre class="overflow-x-auto whitespace-pre-wrap break-words px-4 py-4 font-mono text-[11.5px] leading-[1.75] sm:whitespace-pre sm:px-5 sm:text-[12.5px] sm:leading-[1.8]"><code><span class="ln" style={`--i:${i++}`}><span class="c-kw">&lt;?php</span></span>
{items.map((it) => (<><span class="ln" style={`--i:${i++}`}><span class="c-com">// <span class="c-claim">{it.claim}</span>: {it.why}</span></span>
<span class="ln" style={`--i:${i++}`} set:html={colour(it.code)} />
</>))}<span class="ln" style={`--i:${i++}`}><span class="c-com">// not written: {notWritten.map((w, k) => <><s class="c-strike">{w}</s>{k < notWritten.length - 1 ? ', ' : ''}</>)}</span></span></code></pre>
  </div>
</figure>

<style is:global>
  .hero-code .c-kw { color: #facc48; }
  .hero-code .c-com { color: #6e6d69; font-style: italic; }
  .hero-code .c-claim { color: #facc48; font-style: normal; }
  .hero-code .c-fn { color: #ecebe6; }
  .hero-code .c-str { color: #b9c39f; }
  .hero-code .c-var { color: #a6a49e; }
  .hero-code .c-pun { color: #8a8984; }
  .hero-code .c-strike { color: #6e6d69; text-decoration-color: #facc48; }
  .hero-code .ln { display: inline-block; min-width: 100%; animation: hero-line 0.45s ease-out both; animation-delay: calc(var(--i) * 0.16s + 0.2s); }
  @keyframes hero-line { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hero-code .ln { animation: none; } }
</style>
