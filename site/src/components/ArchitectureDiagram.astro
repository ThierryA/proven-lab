---
// Fig. 1: the application layer and an optional custom app side by side, one choice per row, the Cloud AI API underneath.
// Selecting a setup lights the pieces it uses (data-in lists the setups a piece belongs to).
const setups = [
  { id: 'classic', name: 'Classic', admin: 'WP Admin', frontend: 'WordPress templating', runtimes: 'WordPress' },
  { id: 'front', name: 'Headless Frontend', admin: 'WP Admin', frontend: 'Custom app', runtimes: 'WordPress + custom app' },
  { id: 'admin', name: 'Headless Admin', admin: 'Custom app', frontend: 'WordPress templating', runtimes: 'WordPress + custom app' },
  { id: 'both', name: 'Headless Frontend + Admin', admin: 'Custom app', frontend: 'Custom app', runtimes: 'WordPress + custom app' },
];
const APP = 'front admin both';
const tile = 'relative z-10 m-2 border px-4 py-3 transition-[opacity,border-color,filter] duration-300';
const option = `${tile} border-line bg-ink-2`;
const rowLabel = 'label self-center pr-5 text-right leading-tight';
const conn = 'z-10 flex items-center justify-center font-mono text-[10px] leading-tight text-fg-3';
const name = 'text-[14px] text-fg';
const sub = 'mt-0.5 text-[12px] text-fg-3';
---
<figure class="arch not-prose" data-arch>
  <!-- Setup chips -->
  <div class="mb-6 flex flex-wrap items-center gap-2">
    <span class="label mr-2">Setup</span>
    {setups.map((s) => <button type="button" data-setup={s.id} class="chip border border-line-2 px-3 py-1.5 text-[13px] text-fg-2 transition-colors hover:border-fg-3 hover:text-fg">{s.name}</button>)}
    <button type="button" data-setup="" class="chip-all px-2 py-1.5 font-mono text-[11px] text-fg-3 hover:text-fg">Show all</button>
  </div>

  <!-- Desktop -->
  <div class="hidden grid-cols-[6rem_minmax(0,1fr)_2.5rem_minmax(0,1.4fr)] lg:grid">
    <div data-in={APP} class="col-start-2 row-span-4 row-start-1 border border-dashed border-line-2 transition-[opacity,filter] duration-300"></div>
    <div class="col-start-4 row-span-4 row-start-1 border border-line-2"></div>

    <div data-in={APP} class="relative z-10 col-start-2 row-start-1 px-5 pt-4 pb-1 transition-[opacity,filter] duration-300">
      <p class={name}>Custom app</p><p class={sub}>optional · its own runtime (Node, Next.js and others)</p></div>
    <div class="relative z-10 col-start-4 row-start-1 px-5 pt-4 pb-1">
      <p class={name}>Application layer <span class="font-mono text-[11px] text-fg-3">WordPress · PHP</span></p><p class={sub}>always deployed · data, users, permissions, hooks</p></div>

    <div class={`${rowLabel} col-start-1 row-start-2`}>Admin</div>
    <div data-in="admin both" class={`${option} col-start-2 row-start-2`}><p class={name}>Your admin UI</p><p class={sub}>calls the application layer over REST</p></div>
    <div class={`${conn} col-start-3 row-start-2`}>or</div>
    <div data-in="classic front" class={`${option} col-start-4 row-start-2`}><p class={name}>WP Admin</p><p class={sub}>built in</p></div>

    <div class={`${rowLabel} col-start-1 row-start-3`}>Frontend</div>
    <div data-in="front both" class={`${option} col-start-2 row-start-3`}><p class={name}>Your frontend</p><p class={sub}>calls it over REST or WPGraphQL</p></div>
    <div class={`${conn} col-start-3 row-start-3`}>or</div>
    <div data-in="classic admin" class={`${option} col-start-4 row-start-3`}><p class={name}>WordPress templating</p><p class={sub}>themes render the pages</p></div>

    <div class={`${rowLabel} col-start-1 row-start-4`}>Data &amp;<br/>logic</div>
    <div data-in={APP} class={`${conn} col-start-3 row-start-4 text-sm transition-[opacity,filter] duration-300`}>→</div>
    <a href="/docs/api/content-types" class={`${tile} col-start-4 row-start-4 mb-4 border-fg-3 bg-ink-2 hover:border-fg`}>
      <p class={name}>Application layer</p>
      <p class={sub}><span class="text-fg-2">Core API:</span> content types · fields · users · capabilities · hooks · Abilities API · REST API</p></a>

    <div data-in={APP} class={`${conn} col-start-2 row-start-5 h-10 transition-[opacity,filter] duration-300`}>│ server-side calls</div>
    <div class={`${conn} col-start-4 row-start-5 h-10`}>│ content sync · site connection · Abilities</div>

    <div class={`${rowLabel} col-start-1 row-start-6`}>AI</div>
    <div class="col-span-3 col-start-2 row-start-6 border border-line-2 bg-[radial-gradient(var(--color-line)_1px,transparent_1px)] bg-[size:12px_12px] p-3">
      <div class="flex flex-wrap items-baseline gap-x-3 px-2 pt-1"><p class={name}>Cloud AI API</p><p class={sub}>optional · its own infrastructure · chat, images, speech, transcription, search and agents for the AI features you build</p></div>
      <div class="mt-3 grid grid-cols-3">
        <a href="/docs/ai-api/createChatCompletion" class={`${option} hover:border-fg-3`}><p class={name}>Gateway</p><p class={sub}>chat, images, speech, transcription</p></a>
        <a href="/docs/ai-api/searchCollection" class={`${option} hover:border-fg-3`}><p class={name}>Knowledge base</p><p class={sub}>search over your content</p></a>
        <a href="/docs/ai-api/createAgent" class={`${option} hover:border-fg-3`}><p class={name}>Agents and sessions</p><p class={sub}>conversations grounded in your content</p></a>
      </div>
    </div>
  </div>

  <!-- Mobile -->
  <div class="space-y-px border border-line bg-line lg:hidden">
    <div class="bg-ink p-4"><p class="label">Admin</p><div class="mt-2 grid grid-cols-2 gap-2"><div data-in="classic front" class={option + ' m-0'}><p class={name}>WP Admin</p><p class={sub}>inside WordPress</p></div><div data-in="admin both" class={option + ' m-0 border-dashed border-line-2'}><p class={name}>Your admin UI</p><p class={sub}>custom app</p></div></div></div>
    <div class="bg-ink p-4"><p class="label">Frontend</p><div class="mt-2 grid grid-cols-2 gap-2"><div data-in="classic admin" class={option + ' m-0'}><p class={name}>WordPress templating</p><p class={sub}>inside WordPress</p></div><div data-in="front both" class={option + ' m-0 border-dashed border-line-2'}><p class={name}>Your frontend</p><p class={sub}>custom app</p></div></div></div>
    <div class="bg-ink p-4"><p class="label">Data &amp; logic</p><p class={name + ' mt-2'}>Application layer</p><p class={sub}>Core API: content types, fields, users, capabilities, hooks, Abilities API, REST API.</p></div>
    <div class="bg-ink p-4"><p class="label">AI</p><p class={name + ' mt-2'}>Cloud AI API</p><p class={sub}>chat, images, speech, transcription, knowledge base, agents</p></div>
  </div>

  <!-- Setups: click a row -->
  <div class="mt-8 border-t border-line">
    <div class="label grid grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-4 border-b border-line py-2.5"><span>Setup</span><span>Admin</span><span>Frontend</span><span class="hidden sm:block">Deploy</span></div>
    {setups.map((s) => (
      <button type="button" data-setup={s.id} class="group grid w-full grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-4 border-b border-line py-3 text-left text-[13px] transition-colors hover:bg-ink-2">
        <span class="flex items-center gap-2.5 text-fg"><span class="size-1.5 border border-fg-3 group-[.is-active]:border-signal group-[.is-active]:bg-signal"></span>{s.name}</span>
        <span>{s.admin}</span><span>{s.frontend}</span><span class="hidden sm:block">{s.runtimes}</span>
      </button>
    ))}
  </div>
  <figcaption class="mt-4 font-mono text-[11px] leading-relaxed text-fg-3">
    Fig. 1. Select a setup, above or in the table, to highlight the pieces it uses. The Cloud AI API plugs in the same way in every setup.<br/>
    On WP Engine, a coding agent also runs WP-CLI in a sandboxed session next to the site, through the WP Engine MCP server.
  </figcaption>
</figure>

<style>
  [data-off] { opacity: 0.18; filter: grayscale(1); }
  .is-lit { border-color: var(--color-signal) !important; }
  .chip.is-active { border-color: var(--color-signal); color: var(--color-fg); }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-arch]')) {
    const select = (id: string) => {
      root.querySelectorAll<HTMLElement>('[data-in]').forEach((el) => {
        const on = !id || el.dataset.in!.split(' ').includes(id);
        el.toggleAttribute('data-off', !on);
        el.classList.toggle('is-lit', !!id && on);
      });
      root.querySelectorAll<HTMLElement>('[data-setup]').forEach((b) => b.classList.toggle('is-active', !!id && b.dataset.setup === id));
    };
    root.querySelectorAll<HTMLElement>('[data-setup]').forEach((b) => b.addEventListener('click', () => select(!b.dataset.setup || b.classList.contains('is-active') ? '' : b.dataset.setup)));
  }
</script>
