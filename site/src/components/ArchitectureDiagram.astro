---
// The one diagram that explains Proven: three runtimes, a choice per row.
// Click a setup to highlight the pieces it uses (data-in lists the setups a piece belongs to).
const setups = [
  { id: 'classic', name: 'Classic', admin: 'WP Admin', frontend: 'WordPress templating', runtimes: 'WordPress' },
  { id: 'headless', name: 'Headless', admin: 'WP Admin', frontend: 'Custom app', runtimes: 'WordPress + your app' },
  { id: 'custom', name: 'Custom app', admin: 'Custom app', frontend: 'Custom app', runtimes: 'WordPress + your app' },
];
const tile = 'relative z-10 m-2 rounded-xl px-4 py-3 text-sm ring-1 transition duration-300';
const optional = `${tile} border border-dashed bg-white ring-transparent dark:bg-slate-950`;
const label = 'self-center pr-4 text-right font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-500';
const conn = 'z-10 flex flex-col items-center justify-center px-1 text-center font-mono text-[10px] leading-tight text-slate-400';
---
<div class="arch not-prose" data-arch>
  <div class="flex flex-wrap items-center gap-2">
    <span class="mr-1 text-sm font-semibold text-slate-900 dark:text-white">Show a setup:</span>
    {setups.map((s) => <button type="button" data-setup={s.id} class="rounded-full px-3.5 py-1.5 text-sm font-semibold text-slate-700 ring-1 ring-slate-900/10 transition hover:ring-sky-500 dark:text-slate-200 dark:ring-white/15">{s.name}</button>)}
    <button type="button" data-setup="" class="rounded-full px-3 py-1.5 text-sm text-slate-500 hover:text-slate-900 dark:hover:text-white">All options</button>
  </div>

  <!-- Desktop: runtimes as columns, one choice per row -->
  <div class="mt-6 hidden grid-cols-[4.5rem_minmax(0,1fr)_2.25rem_minmax(0,1.3fr)_3.75rem_minmax(0,1fr)] grid-rows-[auto_auto_auto_auto] lg:grid">
    <!-- runtime boxes (background layer) -->
    <div data-in="headless custom" class="col-start-2 row-span-4 row-start-1 rounded-2xl border border-dashed border-slate-300 bg-slate-50/60 transition duration-300 dark:border-slate-700 dark:bg-slate-900/40"></div>
    <div class="col-start-4 row-span-4 row-start-1 rounded-2xl bg-sky-500/[0.06] ring-1 ring-sky-500/40 dark:bg-sky-400/[0.06] dark:ring-sky-400/40"></div>
    <div class="col-start-6 row-span-4 row-start-1 rounded-2xl bg-indigo-500/[0.06] ring-1 ring-indigo-500/40 dark:bg-indigo-400/[0.06] dark:ring-indigo-400/40"></div>

    <!-- headers -->
    <div data-in="headless custom" class="relative z-10 col-start-2 row-start-1 px-5 pt-4 pb-1 transition duration-300">
      <p class="font-semibold text-slate-900 dark:text-white">Your app</p><p class="text-xs text-slate-500">optional · separate runtime</p></div>
    <div class="relative z-10 col-start-4 row-start-1 px-5 pt-4 pb-1">
      <p class="flex items-center gap-2 font-semibold text-slate-900 dark:text-white"><span class="rounded bg-sky-500/10 px-1.5 py-0.5 font-mono text-[10px] font-bold text-sky-600 dark:text-sky-400">PHP</span>WordPress runtime</p><p class="text-xs text-slate-500">always there · does the work</p></div>
    <div class="relative z-10 col-start-6 row-start-1 px-5 pt-4 pb-1">
      <p class="flex items-center gap-2 font-semibold text-slate-900 dark:text-white"><span class="rounded bg-indigo-500/10 px-1.5 py-0.5 font-mono text-[10px] font-bold text-indigo-600 dark:text-indigo-400">AI</span>AI API</p><p class="text-xs text-slate-500">powers the agents</p></div>

    <!-- row: admin -->
    <div class={`${label} col-start-1 row-start-2`}>Admin</div>
    <div data-in="custom" class={`${optional} col-start-2 row-start-2 border-slate-300 dark:border-slate-600`}><p class="font-semibold text-slate-900 dark:text-white">Custom app</p><p class="text-xs text-slate-500">your own admin UI</p></div>
    <div class={`${conn} col-start-3 row-start-2`}>or</div>
    <div data-in="classic headless" class={`${optional} col-start-4 row-start-2 border-sky-400/60`}><p class="font-semibold text-slate-900 dark:text-white">WP Admin</p><p class="text-xs text-slate-500">built in, inside WordPress</p></div>

    <!-- row: frontend -->
    <div class={`${label} col-start-1 row-start-3`}>Frontend</div>
    <div data-in="headless custom" class={`${optional} col-start-2 row-start-3 border-slate-300 dark:border-slate-600`}><p class="font-semibold text-slate-900 dark:text-white">Custom app</p><p class="text-xs text-slate-500">headless: your own frontend</p></div>
    <div class={`${conn} col-start-3 row-start-3`}>or</div>
    <div data-in="classic" class={`${optional} col-start-4 row-start-3 border-sky-400/60`}><p class="font-semibold text-slate-900 dark:text-white">WordPress templating</p><p class="text-xs text-slate-500">classic: themes render pages, inside WordPress</p></div>

    <!-- row: API -->
    <div class={`${label} col-start-1 row-start-4`}>API</div>
    <div data-in="headless custom" class="relative z-10 col-start-2 row-start-4 m-2 mb-4 flex items-center justify-end rounded-xl px-3 py-3 text-right text-sm font-semibold text-slate-700 transition duration-300 dark:text-slate-300">REST · Abilities</div>
    <div data-in="headless custom" class={`${conn} col-start-3 row-start-4 transition duration-300`}><span class="text-lg text-slate-400">→</span></div>
    <a href="/docs/api/content-types" class={`${tile} col-start-4 row-start-4 mb-4 bg-white ring-sky-500/50 hover:ring-sky-500 dark:bg-slate-950 dark:ring-sky-400/50`}>
      <p class="font-semibold text-sky-700 dark:text-sky-300">Core Runtime API</p>
      <p class="mt-0.5 text-xs text-slate-600 dark:text-slate-400">content types · fields · users · capabilities · hooks · Abilities · REST</p>
      <p class="mt-1.5 font-mono text-[11px] text-emerald-600 dark:text-emerald-400">&gt;_ driven by WP-CLI</p></a>

    <!-- AI column -->
    <div class={`${conn} col-start-5 row-span-3 row-start-2`}><span class="text-lg text-slate-400">⇄</span><span class="mt-1">content<br/>site link<br/>Abilities</span></div>
    <a href="/docs/wpe/createChatCompletion" class={`${tile} col-start-6 row-start-2 bg-white ring-indigo-500/40 hover:ring-indigo-500 dark:bg-slate-950 dark:ring-indigo-400/40`}><p class="font-semibold text-slate-900 dark:text-white">Gateway</p><p class="text-xs text-slate-500">models, images, speech</p></a>
    <a href="/docs/wpe/searchCollection" class={`${tile} col-start-6 row-start-3 bg-white ring-indigo-500/40 hover:ring-indigo-500 dark:bg-slate-950 dark:ring-indigo-400/40`}><p class="font-semibold text-slate-900 dark:text-white">Knowledge base</p><p class="text-xs text-slate-500">search over your content</p></a>
    <a href="/docs/wpe/createAgent" class={`${tile} col-start-6 row-start-4 mb-4 bg-white ring-indigo-500/40 hover:ring-indigo-500 dark:bg-slate-950 dark:ring-indigo-400/40`}><p class="font-semibold text-slate-900 dark:text-white">Agents &amp; sessions</p><p class="text-xs text-slate-500">chat and agent experiences</p></a>
  </div>

  <!-- Mobile: stacked -->
  <div class="mt-6 space-y-3 lg:hidden">
    <div class="rounded-2xl p-4 ring-1 ring-slate-900/10 dark:ring-white/10"><p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-500">Admin</p>
      <div class="mt-2 grid grid-cols-2 gap-2 text-sm"><div data-in="classic headless" class="rounded-lg border border-dashed border-sky-400/60 p-2 transition"><b class="text-slate-900 dark:text-white">WP Admin</b><br/><span class="text-xs">inside WordPress</span></div><div data-in="custom" class="rounded-lg border border-dashed border-slate-300 p-2 transition dark:border-slate-600"><b class="text-slate-900 dark:text-white">Custom app</b><br/><span class="text-xs">separate</span></div></div></div>
    <div class="rounded-2xl p-4 ring-1 ring-slate-900/10 dark:ring-white/10"><p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-500">Frontend</p>
      <div class="mt-2 grid grid-cols-2 gap-2 text-sm"><div data-in="classic" class="rounded-lg border border-dashed border-sky-400/60 p-2 transition"><b class="text-slate-900 dark:text-white">WordPress templating</b><br/><span class="text-xs">inside WordPress</span></div><div data-in="headless custom" class="rounded-lg border border-dashed border-slate-300 p-2 transition dark:border-slate-600"><b class="text-slate-900 dark:text-white">Custom app</b><br/><span class="text-xs">separate (headless)</span></div></div></div>
    <div class="rounded-2xl bg-sky-500/[0.06] p-4 ring-1 ring-sky-500/40"><p class="font-semibold text-slate-900 dark:text-white">WordPress runtime · PHP</p><p class="text-sm">Core Runtime API: content types, fields, users, capabilities, hooks, Abilities, REST. Driven by WP-CLI.</p></div>
    <p class="text-center text-slate-400">⇄</p>
    <div class="rounded-2xl bg-indigo-500/[0.06] p-4 ring-1 ring-indigo-500/40"><p class="font-semibold text-slate-900 dark:text-white">AI API · AI infrastructure</p><p class="text-sm">Gateway · Knowledge base · Agents &amp; sessions. Powers the agents.</p></div>
  </div>

  <!-- Setups -->
  <div class="mt-6 grid gap-3 sm:grid-cols-3">
    {setups.map((s) => (
      <button type="button" data-setup={s.id} class="rounded-2xl p-5 text-left ring-1 ring-slate-900/10 transition hover:ring-sky-500/60 dark:ring-white/10 dark:hover:ring-sky-400/60">
        <p class="font-semibold text-slate-900 dark:text-white">{s.name}</p>
        <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm"><dt class="text-slate-500">Admin</dt><dd class="text-slate-800 dark:text-slate-200">{s.admin}</dd><dt class="text-slate-500">Frontend</dt><dd class="text-slate-800 dark:text-slate-200">{s.frontend}</dd><dt class="text-slate-500">Deploy</dt><dd class="text-slate-800 dark:text-slate-200">{s.runtimes}</dd></dl>
      </button>
    ))}
  </div>
  <p class="mt-3 text-sm text-slate-500">Any mix works, for example a custom admin with WordPress templating. The AI API plugs in the same way in every setup.</p>
</div>

<style>
  [data-off] { opacity: 0.2; filter: grayscale(1); }
  [data-setup].is-active { box-shadow: inset 0 0 0 2px rgb(14 165 233); }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-arch]')) {
    const select = (id: string) => {
      root.querySelectorAll<HTMLElement>('[data-in]').forEach((el) => el.toggleAttribute('data-off', !!id && !el.dataset.in!.split(' ').includes(id)));
      root.querySelectorAll<HTMLElement>('[data-setup]').forEach((b) => b.classList.toggle('is-active', !!id && b.dataset.setup === id));
    };
    root.querySelectorAll<HTMLElement>('[data-setup]').forEach((b) => b.addEventListener('click', () => select(b.classList.contains('is-active') ? '' : b.dataset.setup!)));
  }
</script>
